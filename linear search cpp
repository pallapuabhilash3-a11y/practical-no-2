#include <iostream>
using namespace std;
int main() {
   int arr[] = {21, 43, 23, 54, 75, 13, 5, 8, 25, 10};
   int key, loc = -1;
   cout << "Enter the key to be searched: ";
   cin >> key;
   for (int i = 0; i < 10; i++) {
       if (arr[i] == key) {
           loc = i + 1;
           break;
       }
   }
   if (loc != -1)
       cout << "Key found at position " << loc << endl;
   else
       cout << "Key not found in the array" << endl;
   return 0;
}
